##gff-version 3
# Synthetic RefSeq-style GFF3 (accessions and coordinates are made up) for parser paths the real fixtures
# don't reach. Chromosome names rather than NC_ accessions are used so the contig conversion is visible.
#
# PARX: a pseudoautosomal gene. RefSeq annotates the Y copy with the same GeneID and transcript accession
# under its own feature IDs (-2 suffix), so the transcript keeps the X coordinates and records Y in other_chroms.
X	BestRefSeq	gene	1001	3100	.	+	.	ID=gene-PARX;Dbxref=GeneID:90001,HGNC:HGNC:90001;Name=PARX;description=pseudoautosomal test gene;gbkey=Gene;gene=PARX;gene_biotype=protein_coding
X	BestRefSeq	mRNA	1001	3100	.	+	.	ID=rna-NM_900001.1;Parent=gene-PARX;Dbxref=GeneID:90001,GenBank:NM_900001.1,HGNC:HGNC:90001;Name=NM_900001.1;gbkey=mRNA;gene=PARX;product=pseudoautosomal test protein;tag=RefSeq Select;transcript_id=NM_900001.1
