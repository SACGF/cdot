import csv
import os
import re
import sys
import tempfile
from datetime import datetime
from pathlib import Path

configfile: os.path.join(workflow.basedir, "cdot_transcripts.yaml")

cdot_json = os.path.join(workflow.basedir, "cdot_json.py")
cdot_dir = os.path.dirname(workflow.basedir)
sys.path.insert(0, cdot_dir)
from generate_transcript_data.cdot_json import COMBINE_BUILDS_ARGS
from generate_transcript_data.json_schema_version import JSON_SCHEMA_VERSION

cdot_data_version = JSON_SCHEMA_VERSION

# Load Ensembl -> GENCODE mapping CSV
gencode_csv = os.path.join(workflow.basedir, "ensembl_gencode.csv")
_gencode_map = {}
with open(gencode_csv) as _fh:
    _reader = csv.DictReader(_fh)
    for _r in _reader:
        _gencode_map[_r["Ensembl release"].strip()] = _r["GENCODE release"].strip()

# For manually adding canonical transcripts tags to Ensembl/GRCh37
ensembl_grch37_canonical_transcripts_csv = os.path.join(workflow.basedir, "ensembl_grch37_canonical_transcripts.csv")

# Regex to pull Ensembl release number from a URL (handles release_XX or release-XX)
_re_ensembl_rel = re.compile(r"release[_-](\d+)")

def _ensembl_release_from_url(url: str):
    m = _re_ensembl_rel.search(url)
    return m.group(1) if m else None

# GENCODE (used for Ensembl HGNC IDs) only covers these builds
gencode_genome_builds = {"GRCh37", "GRCh38"}

def _gencode_metadata_path(name: str, url: str) -> str:
    """ GENCODE HGNC metadata file for an Ensembl GRCh37/GRCh38 source. Every such source needs a row in
        ensembl_gencode.csv, otherwise its HGNC IDs would be left out """
    erel = _ensembl_release_from_url(url)
    if erel is None:
        raise ValueError(f"{name}: could not find the Ensembl release number in URL {url}")
    grel = _gencode_map.get(erel)
    if grel is None:
        raise ValueError(f"{name}: Ensembl release {erel} has no GENCODE release in {gencode_csv}, "
                         f"add a row for it (check_new_sources.py reports the GENCODE releases)")
    return f"downloads/gencode_metadata/gencode.v{grel}.metadata.HGNC.gz"


# Name it based on date as it may vary. CI sets CDOT_GENE_INFO_DATE so that parallel jobs
# (possibly straddling midnight) agree on the filename and reuse one shared gene info file
today = os.environ.get("CDOT_GENE_INFO_DATE") or datetime.now().date().isoformat()
gene_info_download_filename = os.path.join("downloads/gene_info", f"Homo_sapiens.gene_info.{today}.gz")
gene_info_json_filename = f"Homo_sapiens.gene-info-{cdot_data_version}.{today}.json.gz"

all_urls = {}
name_uta = {}
multi_urls = {}  # name -> list of URLs, downloaded then concatenated in list order (eg historical #51)
extra_cdot_args = {}  # name -> extra command line args for cdot_json.py
gencode_metadata_paths = {}  # name -> GENCODE HGNC metadata file (Ensembl GRCh37/GRCh38 only)

annotation_consortium_list = []
genome_builds = set()
for annotation_consortium, builds in config["config"].items():
    annotation_consortium_list.append(annotation_consortium)
    for gb, cdot_file_data in builds.items():
        genome_builds.add(gb)
        for name, data in cdot_file_data.items():
            url = None
            if uta := data.get("uta"):
                name_uta[name] = uta
                if schema := uta.get("schema"):
                    url = f"postgresql://uta.biocommons.org/{schema}"
            elif urls := data.get("urls"):
                multi_urls[name] = urls
                url = urls[-1]  # Recorded as the source URL in the JSON
            else:
                url = data.get("url")

            if url:
                all_urls[name] = url

            if cdot_args := data.get("cdot_args"):
                extra_cdot_args[name] = cdot_args

            if annotation_consortium.lower() == "ensembl" and gb in gencode_genome_builds and name not in name_uta:
                gencode_metadata_paths[name] = _gencode_metadata_path(name, url)

if unknown_builds := genome_builds - set(COMBINE_BUILDS_ARGS):
    raise ValueError(f"Genome builds {sorted(unknown_builds)} in the config are not supported by "
                     f"cdot_json.py combine_builds (supported: {sorted(COMBINE_BUILDS_ARGS)})")

genome_builds = list(sorted(genome_builds))
merged_genome_build_label = "_".join(genome_builds).lower()


def get_url_from_name(wildcards):
    return all_urls[wildcards.name]


def get_cdot_command(wildcards):
    url = all_urls[wildcards.name]
    # gffs can end with 'gff.gz' or 'gff3.gz', gtfs always end with 'gtf.gz'
    cdot_command = "gtf_to_json" if url.endswith(".gtf.gz") else "gff3_to_json"
    return cdot_command


def get_build_input_files(wildcards):
    """ This needs to be in order of the YAML file (as we overwrite as we go) """
    cdot_file_data = config["config"][wildcards.annotation_consortium][wildcards.genome_build]
    prefix = f"{wildcards.annotation_consortium}/{wildcards.genome_build}/cdot-{cdot_data_version}"
    input_files = []
    for name, val in cdot_file_data.items():
        if 'url' in val or 'urls' in val:
            filename = prefix + f".{name}.json.gz"
        elif 'uta' in val:
            filename = prefix + f"_uta.{name}.json.gz"
        else:
            raise ValueError(f"Don't know how to handle {name}: {val}")
        input_files.append(filename)
    return input_files


def get_gff_download_path(wildcards):
    """ Multi-URL sources are concatenated into downloads/combined/ """
    if wildcards.name in multi_urls:
        return f"downloads/combined/{wildcards.name}.gz"
    return f"downloads/{wildcards.name}.gz"


rule all:
    input:
        expand("{annotation_consortium}/cdot-" + cdot_data_version + ".all-builds-{annotation_consortium}" + f"-{merged_genome_build_label}.json.gz",
               annotation_consortium=annotation_consortium_list),
        expand("{annotation_consortium}/cdot-" + cdot_data_version + ".{annotation_consortium}.{genome_build}.json.gz",
               annotation_consortium=annotation_consortium_list,
               genome_build=genome_builds)


rule cdot_merge_annotation_consortium:
    input:
        # The per-build file of this consortium for each configured build, named by its combine_builds argument
        unpack(lambda wc: {COMBINE_BUILDS_ARGS[gb]: f"{wc.annotation_consortium}/cdot-{cdot_data_version}.{wc.annotation_consortium}.{gb}.json.gz"
                           for gb in genome_builds})
    output:
        "{annotation_consortium}/cdot-" + cdot_data_version + ".all-builds-{annotation_consortium}" + f"-{merged_genome_build_label}.json.gz"
    params:
        build_args=lambda wc, input: " ".join(f'--{build_arg}="{input_file}"' for build_arg, input_file in input.items())
    shell:
        """
            PYTHONPATH={cdot_dir} \
            {cdot_json} \
                combine_builds \
                {params.build_args} \
                --output "{output}"
        """


rule cdot_merge_historical_json:
    # Merges multiple files together for 1 build
    input:
        get_build_input_files,
    output:
        "{annotation_consortium}/cdot-" + cdot_data_version + ".{annotation_consortium}" + ".{genome_build}.json.gz"
    shell:
        """
            PYTHONPATH={cdot_dir} \
            {cdot_json} \
                merge_historical \
                {input} \
                --genome-build={wildcards.genome_build} \
                --output {output}
        """


rule cdot_gff_json:
    # Individual GFF
    input:
        gene_info_json=gene_info_json_filename,
        gff_file=get_gff_download_path,
        gencode_metadata=lambda wc: gencode_metadata_paths.get(wc.name, [])  # Ensembl GRCh37/GRCh38 only
    output:
        "{annotation_consortium}/{genome_build}/cdot-" + cdot_data_version + ".{name}.json.gz"
    params:
        url=get_url_from_name,
        cdot_command=get_cdot_command,
        extra_cdot_args=lambda wc: extra_cdot_args.get(wc.name, ""),
        gencode_param=lambda wc, input: (
            f'--gencode-hgnc-metadata "{input.gencode_metadata}"' if input.gencode_metadata else ""
        ),
        gene_canonical_transcripts_params=lambda wc: (
            (f'--gene-canonical-transcripts-csv "{ensembl_grch37_canonical_transcripts_csv}"')
            if (wc.annotation_consortium.lower() == "ensembl" and wc.genome_build == "GRCh37")
            else ""
        )
    shell:
        """
            PYTHONPATH={cdot_dir} \
            {cdot_json} \
                {params.cdot_command} \
                "{input.gff_file}" \
                --url "{params.url}" \
                --genome-build="{wildcards.genome_build}" \
                --annotation-consortium="{wildcards.annotation_consortium}" \
                --output "{output}" \
                --gene-info-json="{input.gene_info_json}" \
                {params.gencode_param} \
                {params.gene_canonical_transcripts_params} \
                {params.extra_cdot_args}
        """


rule combine_gff_parts:
    # Multi-URL sources (eg RefSeq historical annotation + alignments, #51) are
    # concatenated in YAML list order (concatenated gzip streams are valid gzip)
    input:
        lambda wc: [f"downloads/parts/{wc.name}.part{i}.gz" for i in range(len(multi_urls[wc.name]))]
    output:
        protected("downloads/combined/{name,[^/]+}.gz")
    shell:
        "cat {input} > {output}"


rule download_gff_part:
    resources:
        connections=1
    output:
        protected("downloads/parts/{name,[^/]+}.part{part,\\d+}.gz")
    params:
        url=lambda wc: multi_urls[wc.name][int(wc.part)]
    shell:
        "curl --fail --show-error -L -o {output} {params.url}"


rule download_gff_files:
    resources:
        connections=1  # We seem to sometimes get failures/booted if too many simultaneous connections to site
    output:
        # Don't re-download if snakemake script changes
        protected("downloads/{name,[^/]+}.gz")
    params:
        url=lambda wc: all_urls[wc.name]
    shell:
        "curl --fail --show-error -L -o {output} {params.url}"


# Download GENCODE metadata (HGNC) for Ensembl builds (wildcarded by GENCODE release)
# Triggered only when cdot_gff_json needs the file (i.e., Ensembl).
rule download_gencode_metadata:
    output:
        protected("downloads/gencode_metadata/gencode.v{grel}.metadata.HGNC.gz")
    params:
        url=lambda wc: f"https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_{wc.grel}/gencode.v{wc.grel}.metadata.HGNC.gz"
    shell:
        "curl --fail --show-error -L -o {output} {params.url}"


rule fetch_uta_from_db:
    output:
        protected("uta/{name}.csv")
    retries: 2  # The public UTA server is sometimes flaky
    params:
        schema=lambda wc: name_uta[wc.name]["schema"],
        template=lambda wc: name_uta[wc.name]["template"],
        csv_url=lambda wc: name_uta[wc.name].get("csv_url")
    run:
        if params.csv_url:
            # Our mirror of the query output (schemas are frozen, so it never changes), so the
            # build doesn't depend on the public UTA server being up. Download to a temp file
            # first so a failed transfer doesn't leave a truncated protected() CSV
            tmp_gz = output[0] + ".download.gz"
            shell(f'curl --fail --show-error -L -o "{tmp_gz}" "{params.csv_url}"')
            shell(f'gunzip -c "{tmp_gz}" > "{output[0]}" && rm "{tmp_gz}"')
            return

        template_file = os.path.join(workflow.basedir, params.template)
        with open(template_file) as f:
            template = f.read()
        sql = template.format(schema=params.schema, output_file=output[0]).replace("\n", " ")

        with tempfile.NamedTemporaryFile(mode="w", delete=False, suffix=".sql") as tf:
            tf.write(sql)
            tf.flush()
            sql_path = Path(tf.name)
        try:
            # ON_ERROR_STOP makes psql exit nonzero if the \copy fails partway, otherwise a
            # truncated CSV would pass, and protected() would keep it forever.
            # The export query aggregates for 10+ minutes before any rows stream back, and NAT
            # (eg on hosted CI runners) drops connections that look idle that long, so send TCP
            # keepalives to hold the connection open
            conninfo = ("host=uta.biocommons.org user=anonymous dbname=uta "
                        "keepalives=1 keepalives_idle=60 keepalives_interval=30 keepalives_count=20")
            shell(f'PGPASSWORD=anonymous psql -v ON_ERROR_STOP=1 -f "{sql_path}" "{conninfo}"')
        finally:
            sql_path.unlink(missing_ok=True)


rule cdot_uta_json:
    input:
        uta_file="uta/{name}.csv"
    output:
        "{annotation_consortium}/{genome_build}/cdot-" + cdot_data_version + "_uta.{name}.json.gz"
    params:
        url=get_url_from_name
    shell:
        """
            PYTHONPATH={cdot_dir} \
            {cdot_json} \
                uta_to_json \
                "{input.uta_file}" \
                --url "{params.url}" \
                --genome-build="{wildcards.genome_build}" \
                --output "{output}"
        """


rule process_gene_info_json:
    input:
        gene_info_download_filename
    output:
        gene_info_json_filename
    shell:
        """
            PYTHONPATH={cdot_dir} \
            "{workflow.basedir}/cdot_gene_info.py" \
                --gene-info {input} \
                --output {output} \
                --email cdot@cdotlib.org
        """


rule download_gene_info:
    output:
        protected(gene_info_download_filename)
    shell:
        "curl --fail --show-error -L -o {output} https://ftp.ncbi.nlm.nih.gov/refseq/H_sapiens/Homo_sapiens.gene_info.gz"
