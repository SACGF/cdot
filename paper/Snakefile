"""Snakemake workflow: generate cdot paper via vibepaper.

Quickstart — build paper using existing facts CSVs (run from project root):
    snakemake -s paper/Snakefile --cores 1

Recompute coverage/benchmark from production data, then build:
    snakemake -s paper/Snakefile --cores 1 --config data_dir=/path/to/cdot/data

Build the quick paper AND a PDF (needs the weasyprint toolchain):
    snakemake -s paper/Snakefile pdf --cores 1

Recompute one facts file:
    snakemake -s paper/Snakefile --cores 1 output/facts/coverage.csv

Every fact is a one-row CSV committed under paper/empirical_results/. Some have a
rule here that recomputes them (see COMPUTED_FACTS); the rest are measured once and
only copied in (FROZEN_FACTS), with their provenance in
paper/empirical_results/PROVENANCE.md. To change a frozen number, edit the CSV there.

Config keys (via --config or a config.yaml):
    data_dir         Directory with production JSON.gz files.
    clinvar_hgvs_csv Path to ClinVar HGVS benchmark CSV.
    uta_uri          PostgreSQL URI for UTA, e.g. postgresql://uta_admin@localhost/uta/uta_20210129
    pdf              Set pdf=true to also render a PDF in the quick/full rules
                     (e.g. snakemake -s paper/Snakefile full --config pdf=true ...).
"""

from pathlib import Path

# ---------------------------------------------------------------------------
# Resolve config
# ---------------------------------------------------------------------------

DATA_DIR    = config.get("data_dir", "")
CLINVAR_CSV = config.get("clinvar_hgvs_csv", "")

def data_file(stem):
    """Return path from explicit config or data_dir/<stem>, else empty string."""
    if stem in config:
        return config[stem]
    if DATA_DIR:
        return str(Path(DATA_DIR) / stem)
    return ""

FILES = {
    "refseq_grch37":  data_file("cdot.refseq.grch37.json.gz"),
    "refseq_grch38":  data_file("cdot.refseq.grch38.json.gz"),
    "refseq_t2t":     data_file("cdot.refseq.t2t.json.gz"),
    "ensembl_grch37": data_file("cdot.ensembl.grch37.json.gz"),
    "ensembl_grch38": data_file("cdot.ensembl.grch38.json.gz"),
}

HAVE_DATA    = any(p and Path(p).exists() for p in FILES.values())
HAVE_CLINVAR = bool(CLINVAR_CSV and Path(CLINVAR_CSV).exists())

PYTHON = ".venv/bin/python"
VIBE   = ".venv/bin/vibepaper build --config paper/paper.toml"

# Optionally also render a PDF alongside the .docx. `--pdf` errors if the
# weasyprint toolchain is missing; opt in with --config pdf=true on quick/full,
# or use the dedicated `pdf` rule.
PDF_FLAG = "--pdf" if config.get("pdf", False) else ""

# The render always reads facts from GEN_FACTS (= paper.toml facts_dir = output/facts).
# How GEN_FACTS gets populated is the only difference between the two build modes:
#   FULL  - regenerate the facts there from production data / benchmark runs.
#   QUICK - copy the committed stored results from EMPIRICAL into there.
# EMPIRICAL is the checked-in snapshot of measured results (NOT "facts" - those are
# the generated templating values); `full` refreshes the computed ones after a
# successful run.
EMPIRICAL  = "paper/empirical_results"
GEN_FACTS  = "output/facts"

# COMPUTED - a rule below regenerates these from data or a benchmark run. When the
# inputs it needs are absent the rule copies the committed EMPIRICAL file instead, so
# a build always renders; `full` writes these back to EMPIRICAL after a good render.
COMPUTED_FACTS = ["coverage.csv", "benchmark.csv", "cleaning.csv",
                  "lovd_comparison.csv", "vv_mutalyzer_comparison.csv",
                  "sources.csv",
                  "version_stability.csv", "positional_drift.csv"]

# FROZEN - measured once (or transcribed from published papers) and committed under
# EMPIRICAL; nothing recomputes them, so the `frozen_fact` rule just copies them in.
# Their provenance (what was run, when, against what data) is in
# EMPIRICAL/PROVENANCE.md, which is where you edit when a number is re-measured.
FROZEN_FACTS = ["literature.csv",
                "clinvar.csv", "clinvar_source_breakdown.csv",
                "clinvar_submitted.csv", "clinvar_submitted_residual.csv",
                "clinvar_vcf.csv", "clinvar_vcf_residual.csv",
                "clinvar_residual_positions.csv", "genomic_mismatch.csv",
                "historical.csv", "version_safety_validation.csv",
                "cleaning_corpus.csv"]

FACT_FILES = COMPUTED_FACTS + FROZEN_FACTS

PAPER_SOURCES = [
    "paper/abstract.md",
    "paper/introduction.md",
    "paper/methods.md",
    "paper/results.md",
    "paper/discussion.md",
    "paper/figures.md",
    "paper/figures/figure1.svg",
    "paper/figures/figure_s1_positional_drift.svg",
    "paper/supplementary.md",
    "paper/references.bib",
    "paper/bioinformatics.csl",
    "paper/paper.toml",
]

# ---------------------------------------------------------------------------
# Rules
# ---------------------------------------------------------------------------

rule all:
    """Default target: the fast (quick) build."""
    input: "output/.paper_built_quick"


rule quick:
    """QUICK build: copy the committed stored results from paper/empirical_results/
    into the facts dir (output/facts/), then render - exactly where a real benchmark
    run would write them, so the render path is identical. No production data, no
    private corpus, no network. Seconds. This is the default."""
    input:
        sources  = PAPER_SOURCES,
        stored   = [f"{EMPIRICAL}/{f}" for f in FACT_FILES],
    output:
        touch("output/.paper_built_quick"),
    shell:
        "mkdir -p {GEN_FACTS} && cp {EMPIRICAL}/*.csv {GEN_FACTS}/ && {VIBE} {PDF_FLAG}"


rule pdf:
    """QUICK build that also renders a PDF (output/cdot_<date>.pdf) next to the
    .docx. Identical to `quick` plus vibepaper --pdf, which needs the weasyprint
    toolchain (pip install -e '.[paper]', or pip install weasyprint). Probe the
    toolchain first with:
        .venv/bin/vibepaper build --config paper/paper.toml --is-pdf-available
    For a full-build PDF instead, run: snakemake -s paper/Snakefile full --config pdf=true ..."""
    input:
        sources = PAPER_SOURCES,
        stored  = [f"{EMPIRICAL}/{f}" for f in FACT_FILES],
    output:
        touch("output/.paper_built_pdf"),
    shell:
        "mkdir -p {GEN_FACTS} && cp {EMPIRICAL}/*.csv {GEN_FACTS}/ && {VIBE} --pdf"


rule full:
    """FULL build: regenerate every fact into output/facts/ from scratch, render,
    then refresh the committed paper/empirical_results/ snapshot. Reproducible facts
    (coverage, ClinVar resolution, throughput, cleaning injection, sources) are
    recomputed - several need --config data_dir=... (and clinvar_hgvs_csv=...,
    uta_uri=...). The Tier-2 cleaning constants (production rescue rates + residual
    taxonomy in results.md) come from the private cdot_private corpus and are
    transcribed by hand; see paper/README.md. Slow (the full-ClinVar throughput
    runs take ~1.5 h each)."""
    input:
        sources = PAPER_SOURCES,
        facts   = [f"{GEN_FACTS}/{f}" for f in FACT_FILES],
    output:
        touch("output/.paper_built_full"),
    params:
        # only the computed facts are written back; the frozen ones came FROM
        # EMPIRICAL, so copying them back would be a no-op that churns mtimes
        writeback = " ".join(f"{GEN_FACTS}/{f}" for f in COMPUTED_FACTS),
    shell:
        # render from the freshly regenerated facts; only refresh the committed
        # snapshot once the render succeeds, so a botched run can't corrupt it
        "{VIBE} {PDF_FLAG} && cp {params.writeback} {EMPIRICAL}/"


rule frozen_fact:
    """Copy a committed stored result from paper/empirical_results/ into the facts dir.

    These are the facts nothing recomputes: measured once against data that is not
    committed here (the full-ClinVar pass, the Shariant historical corpus, the
    submitted-SCV corpus) or transcribed from published papers. They live as CSVs
    under EMPIRICAL and the values are edited there, not here; what produced each
    one is recorded in paper/empirical_results/PROVENANCE.md.
    """
    input:  f"{EMPIRICAL}/{{name}}.csv"
    output: f"{GEN_FACTS}/{{name}}.csv"
    wildcard_constraints:
        name = "|".join(f[:-len(".csv")] for f in FROZEN_FACTS),
    run:
        import os, shutil
        os.makedirs(GEN_FACTS, exist_ok=True)
        shutil.copy(input[0], output[0])
        print(f"Written: {output[0]} (frozen, copied from {input[0]})")


rule coverage:
    """Compute transcript coverage from production JSON.gz files.

    Requires --config data_dir=/path/to/data (or individual file paths).
    Without data, the committed measurement in paper/empirical_results/ is copied
    so the paper build still runs.
    """
    output: "output/facts/coverage.csv"
    run:
        import os, shutil
        os.makedirs("output/facts", exist_ok=True)
        if not HAVE_DATA:
            print("No data_dir - copying the committed measured coverage facts")
            print("  Run with --config data_dir=/path/to/data to recompute them.")
            shutil.copy(f"{EMPIRICAL}/coverage.csv", output[0])
        else:
            flags = " ".join(
                f"--{name.replace('_', '-')} {path}"
                for name, path in FILES.items()
                if path and Path(path).exists()
            )
            shell(f"{PYTHON} paper/scripts/compute_coverage.py {flags}")


rule benchmark:
    """Benchmark HGVS resolution throughput per transcript backend (Table 1).

    Requires --config data_dir=/path/to/data pointing to a GRCh38 RefSeq JSON.gz
    (plus uta_uri=... for the local-UTA row) and HGVS_SEQREPO_DIR in the environment.
    paper/scripts/compute_benchmark.py resolves the identical committed 500-pair
    ClinVar set through every backend, 5 timed passes each, one shared fd-cached
    SeqRepo sequence layer, reporting median and IQR. The public remote UTA rows take
    ~20 min (~0.1 HGVS/s); skip them during development with an edited invocation.
    Without data, the committed measurement in paper/empirical_results/ is copied
    (a real measurement, not a placeholder; conditions in PROVENANCE.md).
    """
    output: "output/facts/benchmark.csv"
    run:
        import os, shutil
        os.makedirs("output/facts", exist_ok=True)
        grch38 = FILES.get("refseq_grch38", "")
        if grch38 and Path(grch38).exists():
            uta_flag = f"--uta-uri {config['uta_uri']}" if "uta_uri" in config else ""
            shell(f"{PYTHON} paper/scripts/compute_benchmark.py --refseq-grch38 {grch38} {uta_flag}")
        else:
            print("No data_dir - copying the committed measured benchmark facts")
            shutil.copy(f"{EMPIRICAL}/benchmark.csv", output[0])


rule cleaning:
    """Tier-1 reproducible injection cleaning benchmark (issue #112).

    Runs on public ClinVar c.HGVS committed to this repo (no data_dir needed).
    Writes both the rich fact JSON and the single-row cleaning.csv used by the
    paper templates. The injection weights are frozen constants citing the
    aggregate production rescue-op distribution (Tier 2) — no corpus data is
    read; see paper/scripts/inject_and_clean.py.
    """
    output: "output/facts/cleaning.csv"
    shell:
        "{PYTHON} paper/scripts/inject_and_clean.py"


rule lovd_comparison:
    """Tier-1 head-to-head: clean_hgvs() vs the LOVD HGVS syntax checker (issue #112).

    Runs the exact injection corpus of the `cleaning` rule through the LOVD
    checker (github.com/LOVDnl/HGVS-syntax-checker, pinned v1.2.2, local PHP
    CLI) and through clean_hgvs(), scored identically; see
    paper/scripts/lovd_head_to_head.py for the scoring rules. Needs a local
    clone of the checker: pass --config lovd_checker=/path/to/HGVS.php (PHP
    >= 7.4 CLI required). Without it, the frozen measured constants from
    paper/empirical_results/ are copied (measured 2026-08-17, checker v1.2.2,
    commit 4cd074ba9cbd, PHP 8.5).
    """
    output: "output/facts/lovd_comparison.csv"
    run:
        import os, shutil
        os.makedirs("output/facts", exist_ok=True)
        checker = config.get("lovd_checker", "")
        if checker and Path(checker).exists():
            shell(f"{PYTHON} paper/scripts/lovd_head_to_head.py --checker {checker}")
        else:
            print("No lovd_checker - copying the frozen measured LOVD comparison facts")
            shutil.copy(f"{EMPIRICAL}/lovd_comparison.csv", output[0])


rule vv_mutalyzer_comparison:
    """Head-to-head: clean_hgvs() vs the VariantValidator and Mutalyzer public
    REST services on the injection corpus (issue #112).

    Same cases and scoring as the lovd_comparison rule, driven by
    paper/scripts/vv_mutalyzer_head_to_head.py over the public APIs
    (rest.variantvalidator.org, mutalyzer.nl). Remote services cannot be
    version-pinned, so the facts record the service date and the version
    metadata the APIs report (measured 2026-08-18, VariantValidator 4.0.1).
    The live run needs network access and about an hour (requests are cached
    and resumable in output/rest_cache/); opt in with --config
    vv_mutalyzer=true. Otherwise the frozen measured constants from
    paper/empirical_results/ are copied.
    """
    output: "output/facts/vv_mutalyzer_comparison.csv"
    run:
        import os, shutil
        os.makedirs("output/facts", exist_ok=True)
        if config.get("vv_mutalyzer", False):
            shell(f"{PYTHON} paper/scripts/vv_mutalyzer_head_to_head.py")
        else:
            print("No vv_mutalyzer=true - copying the frozen measured service comparison facts")
            shutil.copy(f"{EMPIRICAL}/vv_mutalyzer_comparison.csv", output[0])


rule sources:
    """Count annotation releases ingested per consortium/build (the sources.*_releases
    facts in Methods) from generate_transcript_data/cdot_transcripts.yaml - the
    committed source list. No production data needed."""
    output: "output/facts/sources.csv"
    shell:
        "{PYTHON} paper/scripts/compute_sources.py"


rule version_stability:
    """Tier-1 reproducible transcript-version stability facts (R5; C2 experiment).

    How often a transcript version bump is coordinate-preserving, and the pivotal
    structure⇔drift equivalence behind cdot's safe-version-fallback check. Computed
    by paper/scripts/compute_version_stability.py over the *released* cdot JSON.gz
    files (deterministic given --sample/--seed), reusing the packaged
    cdot.hgvs.version_safety helpers — so a referee can regenerate it from public
    release files.

    With single-build GRCh38 data present it recomputes; the all-builds files
    (needed for the cross-build numbers) are taken from --config
    refseq_allbuilds=... ensembl_allbuilds=.... Without data the committed
    measurement in paper/empirical_results/ is copied (GRCh38, --sample 12000
    --seed 1, cdot 0.2.34; see PROVENANCE.md).

    The same script run also bins preserved coding bases by relative CDS position
    (deciles, 5'->3') into positional_drift.csv, conditioned on the partial-drift
    pairs and unconditioned (see the R5 positional-drift figure); it is copied from
    paper/empirical_results/ alongside version_stability.csv when no data is present.
    """
    output:
        "output/facts/version_stability.csv",
        "output/facts/positional_drift.csv",
    run:
        import os, shutil
        os.makedirs("output/facts", exist_ok=True)
        rs38 = FILES.get("refseq_grch38", "")
        en38 = FILES.get("ensembl_grch38", "")
        if rs38 and Path(rs38).exists():
            flags = [f"--refseq-grch38 {rs38}"]
            if en38 and Path(en38).exists():
                flags.append(f"--ensembl-grch38 {en38}")
            for key in ("refseq_allbuilds", "ensembl_allbuilds"):
                p = data_file(key)
                if p and Path(p).exists():
                    flags.append(f"--{key.replace('_', '-')} {p}")
            shell(f"{PYTHON} paper/scripts/compute_version_stability.py {' '.join(flags)}")
        else:
            print("No data_dir - copying the committed measured version-stability facts")
            for name, dest in zip(("version_stability.csv", "positional_drift.csv"), output):
                shutil.copy(f"{EMPIRICAL}/{name}", dest)
